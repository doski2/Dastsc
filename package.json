{
  "name": "dastsc-monorepo",
  "private": true,
  "version": "4.0.0",
  "workspaces": [
    "nexus-kernel",
    "nexus-agent",
    "Dastsc-V4",
    "Dastsc-V3"
  ],
  "scripts": {
    "dev:v3": "npm run dev -w dastsc-nexus-v3",
    "dev:v4": "npm run dev -w dastsc-nexus-v4",
    "build:v3": "npm run build -w dastsc-nexus-v3",
    "build:v4": "npm run build -w dastsc-nexus-v4",
    "test:kernel": "npm run test -w @nexus/kernel",
    "test:agent": "npm run test -w @nexus/agent",
    "test:backend": "python -m unittest discover -s Dastsc-V3/backend/tests -v"
  }
}
